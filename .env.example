# Existing HSK backend (server-side REST requests).
HSK_API_URL=http://localhost:3001/api/v1
# Existing admin application, served separately from this frontend on port 3000.
HSK_ADMIN_URL=http://localhost:3000
# Public origin for image/audio paths returned by the backend.
NEXT_PUBLIC_HSK_MEDIA_ORIGIN=http://localhost:3001
# Socket.IO namespace used by the server-side PK bridge.
# Google OAuth Web Client ID; must match GOOGLE_CLIENT_ID on the backend.
# This is a public client identifier, not a Client Secret.
GOOGLE_CLIENT_ID=
